---
import { getCollection } from 'astro:content';
import Icon from './Icon.astro';
import { url } from '../lib/url';

const leistungen = (await getCollection('leistungen')).sort((a, b) => a.data.reihenfolge - b.data.reihenfolge);
---
<ul class="kacheln">
  {leistungen.map((l, i) => (
    <li>
      <a class="kachel" href={url(`leistungen/#${l.id}`)}>
        <span class="kachel-nr">{String(i + 1).padStart(2, '0')}</span>
        <h3>{l.data.title}</h3>
        <p>{l.data.kurz}</p>
        <span class="kachel-pfeil"><Icon name="pfeil" /></span>
      </a>
    </li>
  ))}
</ul>

<style>
  .kacheln { list-style: none; margin: 0; padding: 0; display: grid; gap: 0.85rem; }
  .kachel {
    position: relative;
    display: block;
    height: 100%;
    padding: 1.5rem 1.4rem 1.6rem;
    border-radius: var(--radius);
    background: #fffaf2;
    border: 1px solid var(--linie);
    text-decoration: none;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }
  .kachel:hover { transform: translateY(-2px); box-shadow: 0 14px 30px -18px rgba(42, 32, 25, 0.4); }
  .kachel-nr { font-family: var(--schrift-titel); font-size: 0.95rem; font-weight: 500; color: var(--holz); }
  .kachel h3 { font-size: 1.6rem; margin: 0.35rem 3rem 0.5rem 0; }
  .kachel p { color: var(--tinte-2); font-size: 0.98rem; line-height: 1.55; }
  .kachel-pfeil {
    position: absolute; top: 1.25rem; right: 1.25rem;
    display: grid; place-items: center;
    width: 2.4rem; height: 2.4rem; border-radius: 999px;
    background: var(--papier-2); color: var(--tinte);
  }
  .kachel-pfeil :global(svg) { width: 1.1rem; height: 1.1rem; transform: rotate(-45deg); }
  @media (min-width: 640px) { .kacheln { grid-template-columns: 1fr 1fr; } }
  @media (min-width: 1000px) { .kacheln { grid-template-columns: repeat(4, 1fr); } }
</style>
