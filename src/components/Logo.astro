---
const { class: klasse } = Astro.props;
---
<svg class={klasse} viewBox="0 0 40 40" aria-hidden="true">
  <rect width="40" height="40" rx="10" fill="#2a2019" />
  <g fill="none" stroke="#e3a64c" stroke-width="2.2" stroke-linecap="round">
    <ellipse cx="20" cy="20" rx="11.5" ry="11.5" />
    <ellipse cx="20.6" cy="20.4" rx="7" ry="6.6" opacity="0.8" />
    <ellipse cx="21" cy="20.8" rx="2.6" ry="2.4" opacity="0.65" />
  </g>
</svg>
