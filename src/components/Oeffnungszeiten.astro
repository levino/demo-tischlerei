---
import Icon from './Icon.astro';
import { betrieb, telefonLink } from '../lib/betrieb';
---
<section id="oeffnungszeiten" class="zeiten" aria-labelledby="oeffnungszeiten-titel">
  <div class="huelle zeiten-raster">
    <div>
      <p class="kicker">Besuchen Sie uns</p>
      <h2 id="oeffnungszeiten-titel" class="zeiten-titel">Öffnungszeiten</h2>
      <dl class="zeiten-liste">
        {betrieb.oeffnungszeiten.map((z) => (
          <div class="zeiten-zeile">
            <dt>{z.tage}</dt>
            <dd>{z.zeit}</dd>
          </div>
        ))}
      </dl>
    </div>
    <div class="kontaktkarte">
      <p class="kontaktkarte-titel">So erreichen Sie uns</p>
      <ul>
        <li><Icon name="ort" /><span>{betrieb.adresse.strasse}<br />{betrieb.adresse.plz} {betrieb.adresse.ort}</span></li>
        <li><Icon name="telefon" /><a href={telefonLink}>{betrieb.telefon}</a></li>
        <li><Icon name="mail" /><a href={`mailto:${betrieb.email}`}>{betrieb.email}</a></li>
      </ul>
      <a class="knopf knopf-hell" href={telefonLink}><Icon name="telefon" /> Jetzt anrufen</a>
    </div>
  </div>
</section>

<style>
  .zeiten { background: var(--espresso); color: var(--papier); padding-block: 4rem; position: relative; }
  .zeiten .kicker { color: var(--honig); }
  .zeiten-titel { font-size: clamp(2.2rem, 9vw, 3.2rem); margin-bottom: 1.5rem; }
  .zeiten-raster { display: grid; gap: 2.5rem; }
  .zeiten-liste { margin: 0; }
  .zeiten-zeile {
    display: flex; justify-content: space-between; align-items: baseline; gap: 1rem;
    padding: 0.95rem 0; border-bottom: 1px solid rgba(246, 240, 230, 0.14);
  }
  .zeiten-zeile:first-child { border-top: 1px solid rgba(246, 240, 230, 0.14); }
  .zeiten-zeile dt { color: rgba(246, 240, 230, 0.75); }
  .zeiten-zeile dd { margin: 0; font-weight: 600; text-align: right; font-variant-numeric: tabular-nums; }
  .kontaktkarte { background: var(--espresso-2); border-radius: var(--radius); padding: 1.6rem 1.4rem; border: 1px solid rgba(246, 240, 230, 0.08); }
  .kontaktkarte-titel { font-family: var(--schrift-titel); font-size: 1.5rem; margin-bottom: 1rem; }
  .kontaktkarte ul { list-style: none; margin: 0 0 1.5rem; padding: 0; display: grid; gap: 0.9rem; }
  .kontaktkarte li { display: flex; gap: 0.85rem; align-items: flex-start; line-height: 1.45; }
  .kontaktkarte li :global(svg) { width: 1.25rem; height: 1.25rem; flex: none; color: var(--honig); margin-top: 0.1rem; }
  .kontaktkarte a:not(.knopf) { text-decoration: none; }
  .kontaktkarte .knopf { width: 100%; }
  @media (min-width: 760px) { .zeiten { padding-block: 6rem; } .zeiten-raster { grid-template-columns: 1.3fr 1fr; gap: 4rem; align-items: start; } }
</style>
